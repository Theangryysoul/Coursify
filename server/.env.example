# Comma separated list of browser origins allowed to call the API.
# Same-origin requests are always allowed, so in production this only needs the
# deployment URL. Add the local Vite origin for development.
# Example: CLIENT_URL=https://coursify.vercel.app,http://localhost:5173
CLIENT_URL=

NODE_ENV=development

PORT=5000

MONGODB_URI=

JWT_ACCESS_SECRET=

JWT_REFRESH_SECRET=

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=

YOUTUBE_API_KEY=
