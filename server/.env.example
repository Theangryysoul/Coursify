# Comma separated list of browser origins allowed to call the API.
# Same-origin requests are always allowed, so in production this only needs the
# deployment URL. Add the local Vite origin for development.
Example: CLIENT_URL=https://coursify.vercel.app,http://localhost:5173
CLIENT_URL=

NODE_ENV=development

PORT=5000

MONGODB_URI=

JWT_ACCESS_SECRET=

JWT_REFRESH_SECRET=

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=

# One or more YouTube Data API keys, comma separated. Extra keys are used
# automatically when the active one reports quotaExceeded, which keeps imports
# working once a key hits its daily limit.
# Example: YOUTUBE_API_KEY=key-one,key-two
YOUTUBE_API_KEY=

# OAuth client id from Google Cloud Console, used to verify Google ID tokens.
# Must be the same value the browser is configured with (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
