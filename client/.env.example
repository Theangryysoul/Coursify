# Optional. Leave unset to use the same-origin API path (/api/v1), which is
# what production uses through the rewrite rules in vercel.json and what the
# Vite dev proxy forwards to http://localhost:5000.
# Only set this when the client has to talk to an API on a different origin.
# VITE_API_URL=http://localhost:5000/api/v1

# OAuth client id from Google Cloud Console, used by the "Sign in with Google"
# button. This value is public and ships in the bundle; the matching secret
# stays on the server as GOOGLE_CLIENT_ID. Leave it unset to hide the button.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
